{
  "name": "pi-ultrawork",
  "version": "1.0.0",
  "description": "Persistent background multi-agent orchestration mode for pi.dev: triggered by saying \"ultrawork\"/\"ulw\", a TUI status indicator, capped hidden auto-continuation, and a ulw_dispatch tool for fanning out child pi processes.",
  "main": "index.js",
  "type": "module",
  "license": "ISC",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "extension",
    "ultrawork",
    "multi-agent",
    "orchestration",
    "tui"
  ],
  "author": "",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.82.1",
    "@types/node": "^24.0.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.6.0",
      "onFail": "download"
    }
  }
}
